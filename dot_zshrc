# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Silence zoxide's doctor self-check. It false-positives in non-interactive
# shells where zoxide's precmd hook isn't registered. Must be set before
# oh-my-zsh inits the zoxide plugin. Harmless no-op when zoxide isn't installed.
export _ZO_DOCTOR=0

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Custom configs + third-party plugins/themes live outside the oh-my-zsh clone
# so chezmoi can manage both (see .chezmoiexternal.toml in the dotfiles repo)
export ZSH_CUSTOM="$HOME/.config/zsh/custom"

# Set theme to Powerlevel10k
ZSH_THEME="powerlevel10k/powerlevel10k"

# Recommended Oh-My-Zsh Settings
HYPHEN_INSENSITIVE="true"             # _ and - are interchangeable
zstyle ':omz:update' mode auto        # update automatically without asking
COMPLETION_WAITING_DOTS="true"        # display red dots whilst waiting for completion
HIST_STAMPS="yyyy-mm-dd"              # command execution time stamp in history

# Active Plugins
plugins=(
  # Completions & Suggestions
  alias-finder
  aliases
  zsh-completions
  zsh-autosuggestions
  zsh-syntax-highlighting
  zsh-history-substring-search
  you-should-use
  fzf-tab

  # Shell Utilities
  colored-man-pages
  extract
  history
  sudo
  safe-paste
  fancy-ctrl-z
  magic-enter
  dirhistory
  direnv
  thefuck
  bgnotify

  # Clipboard
  copybuffer
  copypath
  copyfile

  # Text / Data Tools
  jsontools
  encode64
  urltools
  isodate

  # System & Network
  systemd
  ubuntu
  rsync
  web-search

  # Tools
  eza
  mise
  zoxide
  rbw
  gh
  chezmoi
  rclone
  git-auto-fetch

  # Git
  git
  git-commit
  gitignore

  # Languages
  golang
  node
  npm
  python
  pip
  rust

  # Containers
  docker
  docker-compose
)

# PATH — set before oh-my-zsh loads so plugins can find mise-managed tools
path=(
  "$HOME/.local/share/mise/shims"
  "$HOME/.cargo/bin"                  # rbw (cargo-installed by bootstrap.sh)
  "$HOME/bin"
  "$HOME/.local/bin"
  "/usr/local/bin"
  $path
)
typeset -U path  # deduplicate

# zoxide: replace 'z' with 'cd' for familiar muscle memory
export ZOXIDE_CMD_OVERRIDE=cd

# eza plugin defaults (dirs-first, git status, auto icons)
zstyle ':omz:plugins:eza' 'dirs-first' yes
zstyle ':omz:plugins:eza' 'git-status' yes
zstyle ':omz:plugins:eza' 'icons' yes

# Initialize Oh-My-Zsh (sources everything in $ZSH_CUSTOM/*.zsh)
source $ZSH/oh-my-zsh.sh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
