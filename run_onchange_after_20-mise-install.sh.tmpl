{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Installs everything in ~/.config/mise/config.toml.
# config.toml hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
set -eu

MISE="$HOME/.local/bin/mise"
if [ ! -x "$MISE" ]; then
  echo "mise-install: mise not found at $MISE, skipping (run bootstrap.sh)" >&2
  exit 0
fi

"$MISE" install --yes

# rust-analyzer for Neovim's lang.rust extra (rustaceanvim wants it on PATH, not from Mason).
# mise's rust is rustup-backed, so add the component to the active toolchain.
if "$MISE" which rustup >/dev/null 2>&1; then
  "$MISE" exec -- rustup component add rust-analyzer
fi
{{ end -}}
